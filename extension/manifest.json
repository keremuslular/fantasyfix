{
  "manifest_version": 3,
  "name": "FantasyFix",
  "version": "1.0.0",
  "description": "Fixes missing matchups, game status and stats on ESPN Fantasy by loading ESPN's stats from its working server.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.espn.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "espn_stats_host", "enabled": true, "path": "rules.json" }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fantasyfix@keremuslular.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
